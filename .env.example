# Build-time configuration for TryMeYourPartner
#
# The app does not read a .env file at runtime. These values are passed
# to Flutter as compile-time defines, for example:
#   flutter run -d chrome --dart-define=SUPABASE_KEY=<publishable key>
#
# The Supabase project URL is set in lib/config/supabase_config.dart.

# Supabase publishable key (sb_publishable_...). Safe to ship in the client
# when Row Level Security is enabled. Never use the secret key here.
SUPABASE_KEY=

# Backend mode: "supabase" (default) or "http"
BACKEND_MODE=supabase

# Base URL of the HTTP backend; only used when BACKEND_MODE=http
API_BASE_URL=http://localhost:8080
