# Build-time configuration for the admin console. Passed to Flutter as
# compile-time defines:
#   flutter run -d chrome --dart-define-from-file=.env
#
# Supabase project URL.
SUPABASE_URL=https://lngpmjxiqfskpxbncfgl.supabase.co

# Supabase publishable key (sb_publishable_...). Never the secret key.
SUPABASE_KEY=

# Base URL of the backend API (backend/api), which serves /admin/v1.
API_BASE_URL=http://localhost:8080
