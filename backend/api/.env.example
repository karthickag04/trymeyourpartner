# Supabase project URL and its publishable key (never the secret key)
SUPABASE_URL=https://lngpmjxiqfskpxbncfgl.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# The API's own database login (P2-10). A secret: keep it in this .env or the
# host's secret store, never in the repo. On Supabase use the pooler in session
# mode (Dashboard -> Connect -> Session pooler) and put api_service.<project-ref>
# as the user name:
# DATABASE_URL=postgres://api_service.lngpmjxiqfskpxbncfgl:<password>@aws-<n>-ap-southeast-1.pooler.supabase.com:5432/postgres
# On any other Postgres host: postgres://api_service:<password>@<host>:5432/<db>
DATABASE_URL=
# Connections this API instance keeps open (the live project allows 60 in total).
DATABASE_POOL_SIZE=5
# Role each request runs as, so row-level security applies.
DATABASE_MEMBER_ROLE=authenticated
PORT=8080
# Browser origins allowed to call the API, comma-separated (empty = none)
CORS_ORIGINS=http://localhost:8088
# How access tokens are verified: auto (JWKS when the issuer publishes keys,
# otherwise ask the provider), jwks, or provider. See docs/adr/0001.
TOKEN_VERIFICATION=auto
# Override for another auth provider (any OIDC issuer):
# JWT_ISSUER=https://login.example.com
# JWT_AUDIENCE=authenticated
# JWKS_URL=https://login.example.com/.well-known/jwks.json
