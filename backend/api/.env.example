# Supabase project URL and its publishable key (never the secret key)
SUPABASE_URL=https://lngpmjxiqfskpxbncfgl.supabase.co
SUPABASE_PUBLISHABLE_KEY=
PORT=8080
# Browser origins allowed to call the API, comma-separated (empty = none)
CORS_ORIGINS=http://localhost:8088
# How access tokens are verified: auto (JWKS when the issuer publishes keys,
# otherwise ask the provider), jwks, or provider. See docs/adr/0001.
TOKEN_VERIFICATION=auto
# Override for another auth provider (any OIDC issuer):
# JWT_ISSUER=https://login.example.com
# JWT_AUDIENCE=authenticated
# JWKS_URL=https://login.example.com/.well-known/jwks.json
